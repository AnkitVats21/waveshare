CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# media_player/AudioEngine.cpp uses dynamic_cast<WebMOpusDecoder*>; without
# this, a clean checkout builds with -fno-rtti (ESP-IDF's own default) and
# that dynamic_cast fails to compile.
CONFIG_COMPILER_CXX_RTTI=y

# Board has 16MB flash with a custom partition table (partitions.csv) sized
# for this firmware; the default single 1MB factory partition is too small
# for the built binary (~1.75MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"


CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Increase socket capacity for persistent STAR WebSocket connection, HTTP requests, and streaming
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_DISPLAY_ENABLE=n
# CONFIG_DISPLAY_WIDTH is not set
# CONFIG_DISPLAY_HEIGHT is not set
CONFIG_DISPLAY_SPI_HOST=2
CONFIG_DISPLAY_SCLK_PIN=4
CONFIG_DISPLAY_MOSI_PIN=9
CONFIG_DISPLAY_MISO_PIN=8
CONFIG_DISPLAY_CS_PIN=3
CONFIG_DISPLAY_DC_PIN=7
CONFIG_DISPLAY_RST_PIN=-1
CONFIG_DISPLAY_BL_PIN=5
CONFIG_TOUCH_ENABLE=n
# CONFIG_TOUCH_CS_PIN is not set
# CONFIG_TOUCH_IRQ_PIN is not set

# Needed for the per-core CPU% in the dashboard telemetry (c0/c1): without it
# HttpFileServerService::getCpuUsage() is compiled out and always reports 0.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Run code + rodata from octal PSRAM: ESP-SR (AEC + BSS in afe_feed) is
# instruction-fetch bound. From flash it starves CPU 1 during playback (DIO
# ~95% of a core; QIO still tripped the IDLE1 task watchdog in ww_feed).
# Costs ~app-size (~2.3 MB) of PSRAM. XIP was ruled out as the cause of the
# SD corruption under streaming load (it happens with code in flash too).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# The bootloader is in QIO since 2026-09-23 (changing it needs a USB flash).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM ECC off (the IDF default; it had been switched on by hand). Turning it
# off did not fix the SD corruption seen under streaming load.
# CONFIG_SPIRAM_ECC_ENABLE is not set

# 64-byte data-cache lines (the 32 KB size stays; 64 B lines cost no internal
# RAM). The AFE streams ~850 KB of PSRAM buffers every frame; in the AFE bench
# (bench/afe-ram branch) this took ww_feed from 57% to 45% of CPU 1 idle and
# 74% to 55% while audio plays. Espressif's S3 wake-word examples use 64 B lines
# (with a 64 KB cache, which saves another ~10% but costs 31 KB internal RAM).
# CONFIG_ESP32S3_DATA_CACHE_LINE_32B is not set
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Keep the 8 KB RTC fast RAM out of the heap. It isn't reachable by the SDMMC
# DMA, but IDF's SD driver only checks buffer alignment, so a small malloc that
# lands there (internal RAM is tight during playback) silently reads back zeros
# and writes zeros to the card. Confirmed with a buffer-address log: every
# corrupt download used a buffer at 0x600fe180.
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
