CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# media_player/AudioEngine.cpp uses dynamic_cast<WebMOpusDecoder*>; without
# this, a clean checkout builds with -fno-rtti (ESP-IDF's own default) and
# that dynamic_cast fails to compile.
CONFIG_COMPILER_CXX_RTTI=y

# Board has 16MB flash with a custom partition table (partitions.csv) sized
# for this firmware; the default single 1MB factory partition is too small
# for the built binary (~1.75MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"


CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Increase socket capacity for persistent STAR WebSocket connection, HTTP requests, and streaming
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_DISPLAY_ENABLE=n
# CONFIG_DISPLAY_WIDTH is not set
# CONFIG_DISPLAY_HEIGHT is not set
CONFIG_DISPLAY_SPI_HOST=2
CONFIG_DISPLAY_SCLK_PIN=4
CONFIG_DISPLAY_MOSI_PIN=9
CONFIG_DISPLAY_MISO_PIN=8
CONFIG_DISPLAY_CS_PIN=3
CONFIG_DISPLAY_DC_PIN=7
CONFIG_DISPLAY_RST_PIN=-1
CONFIG_DISPLAY_BL_PIN=5
CONFIG_TOUCH_ENABLE=n
# CONFIG_TOUCH_CS_PIN is not set
# CONFIG_TOUCH_IRQ_PIN is not set

# Needed for the per-core CPU% in the dashboard telemetry (c0/c1): without it
# HttpFileServerService::getCpuUsage() is compiled out and always reports 0.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Run code + rodata from octal PSRAM: ESP-SR (AEC + BSS in afe_feed) is
# instruction-fetch bound. From flash it starves CPU 1 during playback (DIO
# ~95% of a core; QIO still tripped the IDLE1 task watchdog in ww_feed).
# Costs ~app-size (~2.3 MB) of PSRAM. XIP was ruled out as the cause of the
# SD corruption under streaming load (it happens with code in flash too).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# The bootloader is in QIO since 2026-09-23 (changing it needs a USB flash).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM ECC off (the IDF default; it had been switched on by hand). Turning it
# off did not fix the SD corruption seen under streaming load.
# CONFIG_SPIRAM_ECC_ENABLE is not set

# 64-byte data-cache lines (the 32 KB size stays; 64 B lines cost no internal
# RAM). The AFE streams ~850 KB of PSRAM buffers every frame; in the AFE bench
# (bench/afe-ram branch) this took ww_feed from 57% to 45% of CPU 1 idle and
# 74% to 55% while audio plays. Espressif's S3 wake-word examples use 64 B lines
# (with a 64 KB cache, which saves another ~10% but costs 31 KB internal RAM).
# CONFIG_ESP32S3_DATA_CACHE_LINE_32B is not set
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Keep the 8 KB RTC fast RAM out of the heap. It isn't reachable by the SDMMC
# DMA, but IDF's SD driver only checks buffer alignment, so a small malloc that
# lands there (internal RAM is tight during playback) silently reads back zeros
# and writes zeros to the card. Confirmed with a buffer-address log: every
# corrupt download used a buffer at 0x600fe180.
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set

# Server certificates are always verified (components/media_player/include/media_player/TlsConfig.h)
# CONFIG_ESP_TLS_INSECURE is not set

# Software AES. The hardware AES engine uses DMA, and TLS buffers live in PSRAM
# (MBEDTLS_EXTERNAL_MEM_ALLOC), so every record needed bounce buffers and DMA
# descriptors from internal RAM. With the music stream and Gemini both on TLS
# that allocation failed ("esp-aes: Failed to allocate memory"): Gemini could
# not connect over music and the stream reconnected. The tables are ROM tables
# (flash rodata), so software AES costs no internal RAM.
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# mDNS task stack and its packet allocations in PSRAM (internal RAM is the
# scarce one; mDNS does no flash work).
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# TCP receive window 32 KB (22 segments) and a receive mailbox to match.
# The 5.7 KB default (4 segments) caps a connection at ~96 KB/s at 60 ms
# RTT. Every measurement on 2026-10-02 (LAN 1.6-2.2 MB/s, HTTPS 422-468
# KB/s with audio running) used this window; the buffered segments are
# lwIP buffers in PSRAM (L2_TO_L3_COPY below).
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Copy each received frame out of the Wi-Fi driver's buffer into an lwIP
# buffer (PSRAM, SPIRAM_TRY_ALLOCATE_WIFI_LWIP) instead of handing the
# driver buffer up. Without it, data waiting unread in any socket keeps
# driver RX buffers (16 dynamic) busy, and once they run out the radio drops
# every incoming frame, for every connection. Measured 2026-10-02: LAN upload
# with the audio front end running 143-480 KB/s with 9-39 pauses >= 100 ms
# -> 1.6-2.2 MB/s with none; an HTTPS download with audio running ~85 ->
# 422-468 KB/s; a held download no longer silences a Gemini session.
CONFIG_LWIP_L2_TO_L3_COPY=y

# lwIP's link/IP/TCP counters, reported by /api/system/nettest (drops,
# memory errors) to tell loss inside the board from a slow link.
CONFIG_LWIP_STATS=y

# USB network mode (main/services/network/UsbNet.h). The NTB buffers are
# static internal RAM even in serial mode: 2 x 3200 receive + 2 x 2048 send.
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=2
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=2
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=3200
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=2048
