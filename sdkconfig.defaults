CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_BUILTIN_MALLOC=n

CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

CONFIG_BT_COMPANION_ENABLE=n
CONFIG_DISPLAY_ENABLE=n
# CONFIG_DISPLAY_WIDTH is not set
# CONFIG_DISPLAY_HEIGHT is not set
CONFIG_DISPLAY_SPI_HOST=2
CONFIG_DISPLAY_SCLK_PIN=4
CONFIG_DISPLAY_MOSI_PIN=9
CONFIG_DISPLAY_MISO_PIN=8
CONFIG_DISPLAY_CS_PIN=3
CONFIG_DISPLAY_DC_PIN=7
CONFIG_DISPLAY_RST_PIN=-1
CONFIG_DISPLAY_BL_PIN=5
CONFIG_TOUCH_ENABLE=n
# CONFIG_TOUCH_CS_PIN is not set
# CONFIG_TOUCH_IRQ_PIN is not set
